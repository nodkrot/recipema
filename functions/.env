# Shared settings. Private ones go in .env.<project id> (gitignored), e.g. .env.recipema-87dbb:
#
#   # Comma-separated Telegram user IDs allowed to use the bot.
#   # Don't know yours? Deploy once, message the bot, and it will tell you.
#   ALLOWED_USER_IDS=123456789,987654321
#
#   # Telegram user ID -> portal account uid, the author of recipes they add.
#   # Users not listed are saved as "telegram:<their Telegram ID>".
#   AUTHOR_IDS=123456789:portalUid

# Gemini model used to understand requests.
GEMINI_MODEL=gemini-3.5-flash-lite

# Public portal address, used for "open on the site" links.
PORTAL_URL=https://recipema.appletreelabs.com
